const express = require('express');
const router = express.Router();
const { query } = require('../database/connection');

// Get all pipelines with pagination
router.get('/', async (req, res) => {
  try {
    const { page = 1, limit = 20, status, name } = req.query;
    const offset = (page - 1) * limit;
    
    let whereClause = '';
    const params = [];
    let paramCount = 0;

    if (status) {
      whereClause += `WHERE status = $${++paramCount}`;
      params.push(status);
    }

    if (name) {
      whereClause += whereClause ? ' AND ' : 'WHERE ';
      whereClause += `name ILIKE $${++paramCount}`;
      params.push(`%${name}%`);
    }

    const pipelinesQuery = `
      SELECT * FROM pipelines 
      ${whereClause}
      ORDER BY created_at DESC 
      LIMIT $${++paramCount} OFFSET $${++paramCount}
    `;
    
    const countQuery = `
      SELECT COUNT(*) FROM pipelines ${whereClause}
    `;

    params.push(parseInt(limit), offset);

    const [pipelinesResult, countResult] = await Promise.all([
      query(pipelinesQuery, params.slice(0, -2).concat([parseInt(limit), offset])),
      query(countQuery, params.slice(0, -2))
    ]);

    res.json({
      pipelines: pipelinesResult.rows,
      pagination: {
        page: parseInt(page),
        limit: parseInt(limit),
        total: parseInt(countResult.rows[0].count),
        pages: Math.ceil(countResult.rows[0].count / limit)
      }
    });
  } catch (error) {
    console.error('Error fetching pipelines:', error);
    res.status(500).json({ error: 'Failed to fetch pipelines' });
  }
});

// Get pipeline by ID
router.get('/:id', async (req, res) => {
  try {
    const { id } = req.params;
    const result = await query('SELECT * FROM pipelines WHERE id = $1', [id]);
    
    if (result.rows.length === 0) {
      return res.status(404).json({ error: 'Pipeline not found' });
    }
    
    res.json(result.rows[0]);
  } catch (error) {
    console.error('Error fetching pipeline:', error);
    res.status(500).json({ error: 'Failed to fetch pipeline' });
  }
});

// Create new pipeline
router.post('/', async (req, res) => {
  try {
    const {
      name,
      status = 'pending',
      build_time,
      trigger_type = 'manual',
      branch,
      commit_hash,
      logs = ''
    } = req.body;

    if (!name) {
      return res.status(400).json({ error: 'Pipeline name is required' });
    }

    const result = await query(`
      INSERT INTO pipelines (name, status, build_time, trigger_type, branch, commit_hash, logs)
      VALUES ($1, $2, $3, $4, $5, $6, $7)
      RETURNING *
    `, [name, status, build_time, trigger_type, branch, commit_hash, logs]);

    res.status(201).json(result.rows[0]);
  } catch (error) {
    console.error('Error creating pipeline:', error);
    res.status(500).json({ error: 'Failed to create pipeline' });
  }
});

// Update pipeline status
router.patch('/:id/status', async (req, res) => {
  try {
    const { id } = req.params;
    const { status, build_time, logs } = req.body;

    if (!status) {
      return res.status(400).json({ error: 'Status is required' });
    }

    const updateFields = [];
    const params = [];
    let paramCount = 0;

    updateFields.push(`status = $${++paramCount}`);
    params.push(status);

    if (build_time !== undefined) {
      updateFields.push(`build_time = $${++paramCount}`);
      params.push(build_time);
    }

    if (logs !== undefined) {
      updateFields.push(`logs = $${++paramCount}`);
      params.push(logs);
    }

    if (status === 'success' || status === 'failed') {
      updateFields.push(`end_time = $${++paramCount}`);
      params.push(new Date());
    }

    updateFields.push(`updated_at = $${++paramCount}`);
    params.push(new Date());

    params.push(id);

    const result = await query(`
      UPDATE pipelines 
      SET ${updateFields.join(', ')}
      WHERE id = $${++paramCount}
      RETURNING *
    `, params);

    if (result.rows.length === 0) {
      return res.status(404).json({ error: 'Pipeline not found' });
    }

    res.json(result.rows[0]);
  } catch (error) {
    console.error('Error updating pipeline status:', error);
    res.status(500).json({ error: 'Failed to update pipeline status' });
  }
});

// Get pipeline logs
router.get('/:id/logs', async (req, res) => {
  try {
    const { id } = req.params;
    const result = await query('SELECT logs FROM pipelines WHERE id = $1', [id]);
    
    if (result.rows.length === 0) {
      return res.status(404).json({ error: 'Pipeline not found' });
    }
    
    res.json({ logs: result.rows[0].logs });
  } catch (error) {
    console.error('Error fetching pipeline logs:', error);
    res.status(500).json({ error: 'Failed to fetch pipeline logs' });
  }
});

// Update pipeline logs
router.patch('/:id/logs', async (req, res) => {
  try {
    const { id } = req.params;
    const { logs } = req.body;

    if (!logs) {
      return res.status(400).json({ error: 'Logs content is required' });
    }

    const result = await query(`
      UPDATE pipelines 
      SET logs = $1, updated_at = $2
      WHERE id = $3
      RETURNING id, logs
    `, [logs, new Date(), id]);

    if (result.rows.length === 0) {
      return res.status(404).json({ error: 'Pipeline not found' });
    }

    res.json(result.rows[0]);
  } catch (error) {
    console.error('Error updating pipeline logs:', error);
    res.status(500).json({ error: 'Failed to update pipeline logs' });
  }
});

// Delete pipeline
router.delete('/:id', async (req, res) => {
  try {
    const { id } = req.params;
    const result = await query('DELETE FROM pipelines WHERE id = $1 RETURNING id', [id]);
    
    if (result.rows.length === 0) {
      return res.status(404).json({ error: 'Pipeline not found' });
    }
    
    res.json({ message: 'Pipeline deleted successfully' });
  } catch (error) {
    console.error('Error deleting pipeline:', error);
    res.status(500).json({ error: 'Failed to delete pipeline' });
  }
});

// Get recent pipelines (last 24 hours)
router.get('/recent/24h', async (req, res) => {
  try {
    const result = await query(`
      SELECT * FROM pipelines 
      WHERE created_at >= NOW() - INTERVAL '24 hours'
      ORDER BY created_at DESC
    `);
    
    res.json(result.rows);
  } catch (error) {
    console.error('Error fetching recent pipelines:', error);
    res.status(500).json({ error: 'Failed to fetch recent pipelines' });
  }
});

// Get pipeline statistics
router.get('/stats/overview', async (req, res) => {
  try {
    const stats = await query(`
      SELECT 
        COUNT(*) as total_pipelines,
        COUNT(CASE WHEN status = 'success' THEN 1 END) as successful,
        COUNT(CASE WHEN status = 'failed' THEN 1 END) as failed,
        COUNT(CASE WHEN status = 'running' THEN 1 END) as running,
        COUNT(CASE WHEN status = 'pending' THEN 1 END) as pending,
        AVG(build_time) as avg_build_time,
        MAX(created_at) as last_pipeline
      FROM pipelines
    `);

    res.json(stats.rows[0]);
  } catch (error) {
    console.error('Error fetching pipeline stats:', error);
    res.status(500).json({ error: 'Failed to fetch pipeline statistics' });
  }
});

/**
 * NEW ENDPOINT
 * Record pipeline result (for CI/CD integrations like Jenkins/GitHub Actions)
 */
router.post('/cicd-status', async (req, res) => {
  try {
    const {
      name,
      status,
      build_time,
      trigger_type = 'ci',
      branch,
      commit_hash,
      logs = ''
    } = req.body;

    if (!name || !status) {
      return res.status(400).json({ error: 'Pipeline name and status are required' });
    }

    const result = await query(`
      INSERT INTO pipelines (name, status, build_time, trigger_type, branch, commit_hash, logs)
      VALUES ($1, $2, $3, $4, $5, $6, $7)
      RETURNING *
    `, [name, status, build_time, trigger_type, branch, commit_hash, logs]);

    res.status(201).json({
      message: 'Pipeline recorded successfully',
      pipeline: result.rows[0]
    });
  } catch (error) {
    console.error('Error recording pipeline result:', error);
    res.status(500).json({ error: 'Failed to record pipeline result' });
  }
});

module.exports = router;
