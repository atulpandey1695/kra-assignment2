// backend/routes/metrics.js

const express = require("express");
const router = express.Router();
const { query } = require("../db");

// -------------------------
// GET /api/metrics/success-rate
// -------------------------
router.get("/success-rate", async (req, res) => {
  try {
    const result = await query(`
      SELECT 
        ROUND(
          (COUNT(CASE WHEN status = 'success' THEN 1 END)::DECIMAL / NULLIF(COUNT(*), 0)) * 100, 2
        ) as success_rate
      FROM pipelines 
      WHERE created_at >= NOW() - INTERVAL '24 hours'
    `);

    res.json(result.rows[0]);
  } catch (err) {
    console.error("Error fetching success rate:", err);
    res.status(500).json({ error: "Internal Server Error" });
  }
});

// -------------------------
// GET /api/metrics/dashboard-summary
// -------------------------
router.get("/dashboard-summary", async (req, res) => {
  try {
    const result = await query(`
      SELECT 
        COUNT(*) as total_pipelines,
        COUNT(CASE WHEN status = 'success' THEN 1 END) as successful,
        COUNT(CASE WHEN status = 'failed' THEN 1 END) as failed,
        COUNT(CASE WHEN status = 'running' THEN 1 END) as running,
        ROUND(
          (COUNT(CASE WHEN status = 'success' THEN 1 END)::DECIMAL / NULLIF(COUNT(*), 0)) * 100, 2
        ) as success_rate
      FROM pipelines 
      WHERE created_at >= NOW() - INTERVAL '24 hours'
    `);

    res.json(result.rows[0]);
  } catch (err) {
    console.error("Error fetching dashboard summary:", err);
    res.status(500).json({ error: "Internal Server Error" });
  }
});

// -------------------------
// (Optional) Add more metrics routes here
// -------------------------

module.exports = router;
